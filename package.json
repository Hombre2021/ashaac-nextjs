{
  "name": "ashaac-nextjs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node --max-old-space-size=4096 ./node_modules/next/dist/bin/next dev --webpack --hostname 0.0.0.0",
    "dev:ps": "pwsh -ExecutionPolicy Bypass -File ./scripts/dev.ps1",
    "assistant:webhook:set": "pwsh -ExecutionPolicy Bypass -File ./scripts/set-twilio-sms-webhook.ps1",
    "assistant:webhook:set:local": "pwsh -ExecutionPolicy Bypass -File ./scripts/set-twilio-sms-webhook.ps1 -UseLocalhost",
    "assistant:webhook:set:sms": "pwsh -ExecutionPolicy Bypass -File ./scripts/set-twilio-sms-webhook.ps1 -SmsOnly",
    "assistant:webhook:set:voice": "pwsh -ExecutionPolicy Bypass -File ./scripts/set-twilio-sms-webhook.ps1 -VoiceOnly",
    "assistant:webhook:set:all": "pwsh -ExecutionPolicy Bypass -File ./scripts/set-twilio-sms-webhook.ps1 -AllIncomingNumbers",
    "assistant:webhook:set:local:all": "pwsh -ExecutionPolicy Bypass -File ./scripts/set-twilio-sms-webhook.ps1 -UseLocalhost -AllIncomingNumbers",
    "assistant:webhook:dryrun": "pwsh -ExecutionPolicy Bypass -File ./scripts/set-twilio-sms-webhook.ps1 -WhatIf",
    "assistant:webhook:dryrun:all": "pwsh -ExecutionPolicy Bypass -File ./scripts/set-twilio-sms-webhook.ps1 -AllIncomingNumbers -WhatIf",
    "assistant:kb:ingest": "pwsh -NoProfile -Command \"$url = if ($env:ASSISTANT_INGEST_URL) { $env:ASSISTANT_INGEST_URL } else { 'http://localhost:3000/api/assistant/knowledge/ingest?force=true' }; Invoke-RestMethod -Method Post -Uri $url\"",
    "assistant:kb:status": "pwsh -NoProfile -Command \"$url = if ($env:ASSISTANT_KB_STATUS_URL) { $env:ASSISTANT_KB_STATUS_URL } else { 'http://localhost:3000/api/assistant/knowledge/status' }; Invoke-RestMethod -Method Get -Uri $url\"",
    "assistant:parity:daily": "pwsh -NoProfile -Command \"$url = if ($env:ASSISTANT_PARITY_URL) { $env:ASSISTANT_PARITY_URL } else { 'http://localhost:3000/api/assistant/parity/daily' }; $body = @{ normalQuestionPass = $true; pressZeroPass = $true; emergencyTransferPass = $true; smsNumber1Pass = $true; smsNumber2Pass = $true; notes = 'daily parity check' } | ConvertTo-Json; Invoke-RestMethod -Method Post -Uri $url -ContentType 'application/json' -Body $body\"",
    "assistant:parity:summary": "pwsh -NoProfile -Command \"$url = if ($env:ASSISTANT_PARITY_STATUS_URL) { $env:ASSISTANT_PARITY_STATUS_URL } else { 'http://localhost:3000/api/assistant/parity/daily?limit=14' }; Invoke-RestMethod -Method Get -Uri $url\"",
    "assistant:parity:confidence": "pwsh -NoProfile -Command \"$url = if ($env:ASSISTANT_PARITY_CONFIDENCE_URL) { $env:ASSISTANT_PARITY_CONFIDENCE_URL } else { 'http://localhost:3000/api/assistant/parity/confidence?days=7' }; Invoke-RestMethod -Method Get -Uri $url\"",
    "assistant:spam:rules": "pwsh -NoProfile -Command \"$url = if ($env:ASSISTANT_SPAM_RULES_URL) { $env:ASSISTANT_SPAM_RULES_URL } else { 'http://localhost:3000/api/assistant/spam/rules' }; $token = $env:BOOKING_MANAGER_VIEW_TOKEN; $headers = @{}; if ($token) { $headers.Authorization = 'Bearer ' + $token }; Invoke-RestMethod -Method Get -Uri $url -Headers $headers\"",
    "assistant:spam:reviews": "pwsh -NoProfile -Command \"$url = if ($env:ASSISTANT_SPAM_REVIEWS_URL) { $env:ASSISTANT_SPAM_REVIEWS_URL } else { 'http://localhost:3000/api/assistant/spam/reviews?limit=50' }; $token = $env:BOOKING_MANAGER_VIEW_TOKEN; $headers = @{}; if ($token) { $headers.Authorization = 'Bearer ' + $token }; Invoke-RestMethod -Method Get -Uri $url -Headers $headers\"",
    "assistant:parity": "pwsh -ExecutionPolicy Bypass -File ./scripts/run-assistant-parity-check.ps1",
    "assistant:verify-deployment": "node ./scripts/verify-assistant-deployment.mjs",
    "assistant:verify-script": "node ./scripts/verify-phone-script-parity.mjs",
    "validate:productivity": "node ./scripts/validate-productivity.mjs",
    "prebuild": "npm run validate:productivity && npm run assistant:verify-deployment && npm run assistant:verify-script",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "appointments:list": "node ./scripts/manage-appointments.mjs list",
    "appointments:find": "node ./scripts/manage-appointments.mjs find",
    "appointments:delete": "node ./scripts/manage-appointments.mjs delete"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@vercel/blob": "^2.6.1",
    "next": "^16.3.3",
    "next-seo": "^7.0.1",
    "next-sitemap": "^4.2.3",
    "openai": "^7.1.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.70.0",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.45.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "eslint": "^9",
    "eslint-config-next": "16.1.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
